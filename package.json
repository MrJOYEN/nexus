{
  "name": "nexus",
  "productName": "Nexus",
  "version": "1.0.0",
  "description": "All your web apps in one window, each account in its own isolated session.",
  "author": "Mehdi Joyen",
  "license": "MIT",
  "homepage": "https://github.com/MrJOYEN/nexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrJOYEN/nexus.git"
  },
  "bugs": {
    "url": "https://github.com/MrJOYEN/nexus/issues"
  },
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mehdi.nexus",
    "productName": "Nexus",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "files": [
      "**/*",
      "!assets/brand/**",
      "!installer/**",
      "!docs/**",
      "!test/**",
      "!**/*.md",
      "!.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "installer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MrJOYEN",
        "repo": "nexus"
      }
    ]
  }
}
